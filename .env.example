# IMAP backend
IMAP_HOST=mail.example.com
IMAP_PORT=993
IMAP_SSL=true
IMAP_TIMEOUT=10.0

# OIDC issuer — must match the public URL the bridge is reachable at
OIDC_ISSUER=https://imap-bridge.example.com

# Single OIDC client (the consumer, e.g. Authentik)
OIDC_CLIENT_ID=authentik
OIDC_CLIENT_SECRET=replace-with-long-random-string
# JSON list of allowed redirect URIs (one or more)
OIDC_REDIRECT_URIS=["https://sso.example.com/source/oauth/callback/imap-bridge/"]

# Optional tuning
OIDC_CODE_TTL=60
OIDC_TOKEN_TTL=3600

# Storage for the RSA signing key (mount a volume here)
DATA_DIR=/data

# Cookie/state signer secret — any long random string
SESSION_SECRET=replace-with-long-random-string

# Runtime
LOG_LEVEL=INFO
BIND_HOST=0.0.0.0
BIND_PORT=8000

# Optional branding for the login form. All fields are optional — defaults
# render a generic neutral "Sign in" form with no logo and no external assets.
#
# ── Identity ──
# BRAND_LOGO_URL=https://logo.example.com/logo.svg
# BRAND_TITLE=Sign in
# BRAND_SUBTEXT=Sign in with your example.com mailbox.
#
# ── Free-HTML content slots (operator-trusted; rendered verbatim) ──
# BRAND_HEADER_HTML=<strong>Welcome to Example.</strong> Login uses your mailbox.
# BRAND_BELOW_FORM_HTML=Need help? Email <a href="mailto:admin@example.com">admin@example.com</a>.
# BRAND_FOOTER_HTML=Run by Example e.V. — your password stays in your mailbox.
#
# ── Structured footer links (JSON list of {label, href}) ──
# BRAND_FOOTER_LINKS=[{"label":"Impressum","href":"https://example.com/impressum"},{"label":"Datenschutz","href":"https://example.com/datenschutz"}]
#
# ── Visual ──
# BRAND_ACCENT_COLOR=#7c3aed
# BRAND_BACKGROUND_URL=https://example.com/background.jpg
#
# ── String overrides (lighter than full i18n; defaults are English) ──
# BRAND_LANG=de
# BRAND_LABEL_EMAIL=E-Mail
# BRAND_LABEL_PASSWORD=Passwort
# BRAND_LABEL_SUBMIT=Anmelden
# BRAND_LABEL_SUBMITTING=Anmelden…
# BRAND_PLACEHOLDER_EMAIL=du@example.com
# BRAND_ARIA_FOOTER_LINKS=Rechtliche Hinweise
# BRAND_ERROR_EMPTY_CREDENTIALS=E-Mail und Passwort sind erforderlich.
# BRAND_ERROR_INVALID_CREDENTIALS=Ungültige E-Mail oder Passwort.
# BRAND_ERROR_UPSTREAM_UNREACHABLE=Mailserver ist gerade nicht erreichbar. Bitte erneut versuchen.
# BRAND_ERROR_UPSTREAM_ERROR=Mailserver hat einen Fehler zurückgegeben.
