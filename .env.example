# IMAP backend
IMAP_HOST=mail.example.com
IMAP_PORT=993
IMAP_SSL=true
IMAP_TIMEOUT=10.0

# OIDC issuer — must match the public URL the bridge is reachable at
OIDC_ISSUER=https://imap-bridge.example.com

# Single OIDC client (the consumer, e.g. Authentik)
OIDC_CLIENT_ID=authentik
OIDC_CLIENT_SECRET=replace-with-long-random-string
# JSON list of allowed redirect URIs (one or more)
OIDC_REDIRECT_URIS=["https://sso.example.com/source/oauth/callback/imap-bridge/"]

# Optional tuning
OIDC_CODE_TTL=60
OIDC_TOKEN_TTL=3600

# Storage for the RSA signing key (mount a volume here)
DATA_DIR=/data

# Cookie/state signer secret — any long random string
SESSION_SECRET=replace-with-long-random-string

# Runtime
LOG_LEVEL=INFO
BIND_HOST=0.0.0.0
BIND_PORT=8000

# Optional branding for the login form. All three are optional — defaults
# render a generic "Sign in" form with no logo. Set BRAND_LOGO_URL to any
# externally-hosted SVG/PNG (no external assets are bundled with the bridge).
# BRAND_LOGO_URL=https://logo.example.com/logo.svg
# BRAND_TITLE=Sign in
# BRAND_SUBTEXT=Sign in with your example.com mailbox.
